PORT=4000
NODE_ENV=development

# --- Databases (leave empty for the built-in in-memory engines) ---
DATABASE_URL=            # e.g. postgres://drp:drp@localhost:5432/drp  or a Neon URL
MONGO_URL=               # e.g. mongodb://localhost:27017/drp         or an Atlas URL

ML_URL=http://localhost:8000
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGIN=*

# --- Simulation ---
SIM_ENABLED=true
SIM_SPEED=30
SIM_INTERVAL_MS=5000
AUTO_DISPATCH=true

# --- Resilience / offline ---
NODE_ID=chennai-eoc
NODE_ROLE=edge                       # edge (control room) | cloud (state HQ)
CLOUD_SYNC_URL=                      # e.g. http://localhost:4200 or https://drp-cloud.onrender.com
SYNC_KEY=dev-sync-key
CONNECTIVITY_CHECK_URL=https://api.open-meteo.com
TILE_URL=                            # optional self-hosted tile server for full-detail offline maps

# --- SMS gateway ---
SMS_PROVIDER=simulated               # simulated | android | twilio
SMS_GATEWAY_URL=                     # android: http://<phone-ip>:8080/send (works without internet)
HELPLINE_NUMBER=+91 90000 11200
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=

# --- External data (used when internet is available) ---
WEATHER_ENABLED=true
OSRM_ENABLED=true
OSRM_URL=https://router.project-osrm.org

# --- Web push (auto-generated into .vapid.json if empty) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
